SUPABASE_URL=https://your-fresh-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Ingestion only. Never expose this key in VITE_ variables.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-key
GEMINI_API_KEY=your-new-gemini-key
GEMINI_MODEL=gemini-3.8-flash
# Set to 1 only for the self-contained localhost demonstration.
DEMO_AI=0
ALLOWED_ORIGINS=http://127.0.0.1:8085,http://localhost:8085
DATA_DIR=./data
CHAT_MIN_SIMILARITY=0.3
PROVIDER_TIMEOUT_SECONDS=45
